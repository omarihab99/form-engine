{
  "name": "form-engine",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w packages/core",
    "build:react": "npm run build -w packages/react",
    "build:spfx": "npm run build -w packages/spfx",
    "test": "jest --passWithNoTests",
    "test:core": "jest --selectProjects core",
    "test:react": "jest --selectProjects react",
    "test:spfx": "jest --selectProjects spfx",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf packages/*/dist dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.0",
    "typescript": "~5.5.4"
  }
}
